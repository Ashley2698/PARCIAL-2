@startuml
skinparam classBackgroundColor #F3F3F3
skinparam classBorderColor #2E8B57
skinparam classFontSize 12

class Usuarios {
  +nombres: String
  +direccion: String
  +email: String
  +rol: String
  +registrar(): void
  +iniciarSesion(): void
  +actualizarPerfil(): void
  +cambiarContraseña(): void
}

class Paciente {
  +nombres: String
  +direccion: String
  +email: String
  +registrar(): void
  +actualizar(): void
  +eliminar(): void
}

class Expediente {
  +fecha: Date
  +descripcion: String
  +idEmpleado: String
  +idPaciente: String
  +fechaCita: Date
  +registrar(): void
  +actualizar(): void
}

class Terapia {
  +fecha: Date
  +descripcion: String
  +idEmpleado: String
  +idPaciente: String
  +fechaCita: Date
  +registrar(): void
  +actualizar(): void
}

class Cita {
  +idPaciente: String
  +fecha: Date
  +descripcion: String
  +idEmpleado: String
  +generarCita(): void
  +editarCita(): void
  +eliminarCita(): void
}

Usuarios -- Paciente : "Gestiona perfil"
Paciente -- Expediente : "Tiene"
Paciente -- Terapia : "Recibe"
Paciente -- Cita : "Agenda"

@enduml